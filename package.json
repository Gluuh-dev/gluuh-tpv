{
  "name": "gluuh-tpv",
  "version": "0.0.0",
  "private": true,
  "description": "Plataforma TPV de hostelería (web + Windows + Android/iOS + backend). Monorepo.",
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "eslint .",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "core:demo": "pnpm --filter @gluuh/core demo",
    "core:test": "pnpm --filter @gluuh/core test",
    "cf:build": "pnpm --filter @gluuh/core build && pnpm --filter @gluuh/web exec opennextjs-cloudflare build",
    "cf:deploy": "pnpm --filter @gluuh/web exec wrangler deploy"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@next/eslint-plugin-next": "^16.2.10",
    "eslint": "^9",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.7.0",
    "pg": "^8.21.0",
    "turbo": "^2.9.18",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.63.0"
  }
}
