# =============================================================================
#  Gluuh — variables de entorno (PLANTILLA)
# =============================================================================
#  ⚠️  Este archivo (.env.example) SÍ se sube al repositorio. NO pongas aquí
#      ningún valor real ni contraseña — solo marcadores de posición.
#
#  Para usar valores reales: copia este archivo a `.env` (y, por app, a
#  `apps/web/.env.local` y `apps/api/.env`). Esos SÍ están en .gitignore.
#
#  Las contraseñas de cuentas (Gmail, GitHub, banco…) NO van en ningún .env:
#  guárdalas en un gestor de contraseñas (Bitwarden). Ver docs/15.
# =============================================================================

# --- Supabase (cliente / web) -------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://<ref-del-proyecto>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxx
# Clave SECRETA de Supabase (rutas API admin/dispositivos/instalación) — es la
# variable que LEE el código (`process.env.SUPABASE_SECRET_KEY`). Solo servidor,
# NUNCA en el cliente:
SUPABASE_SECRET_KEY=

# --- Web (rutas API de dispositivos y plataforma) -----------------------------
# Secreto para firmar los JWT de dispositivos emparejados (apps/web/app/api/dispositivos/*):
DEVICE_JWT_SECRET=
# URL pública de la app (enlaces en códigos QR de emparejado):
GLUUH_URL=https://app.gluuh.com
# Hosts (separados por coma) que sirven la consola de plataforma (admin.gluuh.com):
PLATAFORMA_HOSTS=admin.gluuh.com

# --- Base de datos (Postgres de Supabase) ------------------------------------
# Pooler en modo transacción (app):
DATABASE_URL="postgresql://postgres.<ref>:[YOUR-PASSWORD]@aws-0-eu-west-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
# Pooler en modo sesión (migraciones):
DIRECT_URL="postgresql://postgres.<ref>:[YOUR-PASSWORD]@aws-0-eu-west-1.pooler.supabase.com:5432/postgres"

# --- API (NestJS) --------------------------------------------------------------
PORT=3001
JWT_SECRET=
# OBLIGATORIO: token de servicio que exige la API en `Authorization: Bearer …`.
# Sin él la API deniega TODO (falla cerrado). La llaman la web y el nodo local,
# nunca un navegador anónimo. Genera uno largo y aleatorio.
GLUUH_API_TOKEN=
# Orígenes permitidos por CORS (coma-separados). Vacío = ningún cross-origin.
CORS_ORIGINS=http://localhost:3100

# --- Pagos (Stripe) — ver docs/08 --------------------------------------------
STRIPE_SECRET_KEY=sk_test_xxxxxxxx

# --- AEAT VERIFACTU — ver docs/07 --------------------------------------------
AEAT_ENTORNO=pruebas
AEAT_CERT_PATH=./secrets/certificado.p12
# Alternativa al fichero: el .pfx en base64 (apps/api/src/fiscal/aeat.service.ts):
AEAT_CERT_PFX=
AEAT_CERT_PASSWORD=

# --- Móvil (Expo) --------------------------------------------------------------
EXPO_PUBLIC_SUPABASE_URL=https://<ref-del-proyecto>.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxx

# ─────────────────────────────────────────────────────────────────────────────
#  NODO LOCAL — sólo en las terminales de un bar con nodo (no en la nube).
#
#  El TPV deja de hablar con Supabase y habla con el mini-PC de la barra. No cambia
#  ni una línea de código: sólo estas tres variables.
# ─────────────────────────────────────────────────────────────────────────────

# Enciende el modo nodo: el realtime pasa a ser SSE y las fotos se piden al nodo.
# NEXT_PUBLIC_NODO_LOCAL=1

# La IP del nodo en la red del bar (la que imprime arrancar-nodo.ps1).
# Sustituye a la URL de Supabase: de aquí cuelgan /rest/v1, /auth/v1, /realtime/v1
# y /storage/v1, igual que en la nube.
# NEXT_PUBLIC_SUPABASE_URL=http://192.168.1.50:54321

# La clave `anon` del nodo. La genera:  node apps/nodo/claves.mjs "<secreto-jwt>"
# NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ⚠️ Y LA SECRETA TAMBIÉN ES LA DEL NODO, no la de Supabase (`sb_secret_…`).
#
# Es el error fácil de cometer y el que más cuesta diagnosticar: `/api/entrar-operario`
# usa esta clave contra `NEXT_PUBLIC_SUPABASE_URL` — que en modo nodo ES EL NODO. Con la
# clave de la nube puesta aquí, el nodo la rechaza y **ningún camarero puede entrar**.
#
# La imprime el mismo comando de arriba (la segunda que saca, la `service_role`).
# SUPABASE_SECRET_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# La URL REAL de Supabase. Se sigue necesitando aunque no haya internet: es la que se
# guarda en la BD al subir una foto (la canónica), para que el dato que se sincroniza
# no lleve dentro una dirección de la red local del bar. Al pintar, urlFoto() la
# redirige al nodo.
# NEXT_PUBLIC_SUPABASE_URL_NUBE=https://<proyecto>.supabase.co
