# ── TPV (apps/tpv) — variables de DESARROLLO ────────────────────────────────
# Copia a `.env.local` (ignorado por git) y ajusta. En producción NADA de esto
# se usa: el build queda en modo "nodo" sin sesión de dev (manda el emparejado
# real de cada terminal).

# DESTINO de los datos mientras diseñas conectado:
#   nodo  → el Postgres del nodo (por defecto). Requiere el nodo arrancado
#           (gateway :54321 + PG :55432). Es el destino de PRODUCCIÓN.
#   nube  → Supabase directo. No necesita el nodo; útil para diseñar cuando el
#           nodo aún se programa. Requiere SUPABASE_JWT_SECRET (abajo).
VITE_DESTINO=nodo

# Tenant contra el que trabajar (por defecto el «Restaurante de pruebas»).
# VITE_TENANT=4c792677-c66b-4af8-bd3f-8c2e32031db8

# SOLO para VITE_DESTINO=nube: el JWT secret (legacy) del proyecto Supabase.
# Está en el panel de Supabase → Settings → API → JWT Secret. NO se versiona;
# NO viaja al bundle: `vite.config.ts` lo usa solo para FIRMAR el token de dev.
# SUPABASE_JWT_SECRET=

# Overrides opcionales (normalmente no hacen falta):
# VITE_NODO_PROXY=http://localhost:54321   # a qué gateway reenvía el proxy (nodo)
# VITE_SUPABASE_URL=https://gxcqihslbicrszgzudjs.supabase.co
# VITE_SUPABASE_ANON=<anon key>            # ya viene por defecto en vite.config
