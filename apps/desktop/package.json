{
  "name": "@gluuh/desktop",
  "version": "0.1.0",
  "private": true,
  "author": "Gluuh",
  "description": "TPV de barra (Windows) con Electron — carga la web operativa (/tpv) y gestiona el hardware local: impresora ESC/POS, cajón, visor de cliente y copia de seguridad a USB.",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc",
    "dev": "tsc && electron .",
    "start": "tsc && electron .",
    "servidor": "tsc && electron dist/servidor.main.js",
    "dist": "tsc && electron-builder",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@gluuh/hardware": "workspace:*",
    "electron-updater": "^6.8.9"
  },
  "devDependencies": {
    "@types/node": "^25.9.5",
    "electron": "^42.7.0",
    "electron-builder": "^26.15.3",
    "typescript": "^6.0.3"
  }
}
