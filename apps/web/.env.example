# Plantilla de entorno de la web (Next.js). SE SUBE al repo: solo placeholders.
# Copia a apps/web/.env.local (ignorado por git) y pon los valores reales.

NEXT_PUBLIC_SUPABASE_URL=https://<ref-del-proyecto>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxx

# Solo servidor (route handlers). Nunca NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxx
# Firma de las credenciales de dispositivo (/conectar). Cadena aleatoria larga.
DEVICE_JWT_SECRET=cambia-esto-por-una-cadena-aleatoria-larga
