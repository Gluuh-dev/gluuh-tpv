{
  // Despliegue de @gluuh/web en Cloudflare Workers vía OpenNext (guía plan 09, B).
  // Los subdominios (www/app/admin.gluuh.com) se enrutan a este Worker desde el
  // panel de Cloudflare (Custom Domains). PLATAFORMA_HOSTS separa /admin por host.
  "$schema": "node_modules/wrangler/config-schema.json",
  "main": ".open-next/worker.js",
  "name": "gluuh",
  "compatibility_date": "2024-12-30",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    { "binding": "WORKER_SELF_REFERENCE", "service": "gluuh" }
  ]
}
