{
  "name": "@gluuh/hardware",
  "version": "0.0.0",
  "private": true,
  "description": "Impresora ESC/POS, cajón portamonedas y periféricos del TPV. Driver real por red (tcp://) con node-thermal-printer.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --clean",
    "typecheck": "tsc --noEmit",
    "lint": "echo \"(lint pendiente)\""
  },
  "dependencies": {
    "node-thermal-printer": "^4.4.5"
  },
  "devDependencies": {
    "@types/node": "^25.9.3",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3"
  }
}
